shiny::runApp()
runApp()
runApp()
runApp()
runApp()
runApp()
# Verificar si las funciones de módulo están disponibles en la sesión
exists("mod_inicio_ui")
# Intentar cargar los módulos manualmente para ver si hay errores
tryCatch(
source("modules/mod_inicio.R",     local = FALSE),
error = function(e) cat("ERROR mod_inicio:", conditionMessage(e), "\n")
)
tryCatch(
source("modules/mod_negocio.R",    local = FALSE),
error = function(e) cat("ERROR mod_negocio:", conditionMessage(e), "\n")
)
tryCatch(
source("modules/mod_eda.R",        local = FALSE),
error = function(e) cat("ERROR mod_eda:", conditionMessage(e), "\n")
)
tryCatch(
source("modules/mod_wrangling.R",  local = FALSE),
error = function(e) cat("ERROR mod_wrangling:", conditionMessage(e), "\n")
)
tryCatch(
source("modules/mod_modelo.R",     local = FALSE),
error = function(e) cat("ERROR mod_modelo:", conditionMessage(e), "\n")
)
tryCatch(
source("modules/mod_evaluacion.R", local = FALSE),
error = function(e) cat("ERROR mod_evaluacion:", conditionMessage(e), "\n")
)
tryCatch(
source("modules/mod_rfm.R",        local = FALSE),
error = function(e) cat("ERROR mod_rfm:", conditionMessage(e), "\n")
)
tryCatch(
source("modules/mod_datos.R",      local = FALSE),
error = function(e) cat("ERROR mod_datos:", conditionMessage(e), "\n")
)
cat("Módulos disponibles:", exists("mod_inicio_ui"), "\n")
runApp()
# Probar que ui.R se puede evaluar correctamente con los módulos cargados
tryCatch(
source("ui.R", local = FALSE),
error = function(e) cat("ERROR en ui.R:", conditionMessage(e), "\n")
)
cat("ui definida:", exists("ui"), "\n")
runApp()
# Verificar que las funciones de módulo están en el entorno global
stopifnot(exists("mod_inicio_ui"))
cat("Módulos OK. Listo para runApp().\n")
runApp()
runApp()
